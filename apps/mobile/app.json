{
  "expo": {
    "name": "Travel App",
    "slug": "travel-app",
    "scheme": "travelapp",
    "version": "0.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#060B18",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "com.travelapp.companion",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#060B18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-noglow.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#060B18",
          "dark": {
            "image": "./assets/splash-icon-noglow.png",
            "backgroundColor": "#060B18"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "@rnmapbox/maps",
      "./plugins/withTurboModuleInterop",
      "./plugins/withShortNativeBuildDir",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1561BC",
          "defaultChannel": "flight-changes"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/rubik/400Regular/Rubik_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/rubik/500Medium/Rubik_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/rubik/600SemiBold/Rubik_600SemiBold.ttf",
            "../../node_modules/@expo-google-fonts/rubik/700Bold/Rubik_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-asset",
      "@react-native-google-signin/google-signin",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/withPassportBackupRules",
      "./plugins/withUploadSigning",
      [
        "expo-camera",
        {
          "cameraPermission": "כדי לצלם את עמוד הפרטים של הדרכון. הצילום נשמר רק במכשיר.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": true,
      "forcesRTL": true,
      "eas": {
        "projectId": "acf23314-81dd-4f05-a2e9-5bbef56b4f11"
      }
    },
    "owner": "yossile54"
  }
}
