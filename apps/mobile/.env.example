# Copy this file to .env.local and fill in the values. Never commit .env.local.
# See docs/setup/accounts.md for where each value comes from.

# Mapbox public token (starts with pk.). Safe to ship in the app, but kept
# out of git so it can be rotated.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Supabase project URL and its publishable (anon) key: never the service key,
# which must not ship in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Google sign-in: the OAuth web client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
