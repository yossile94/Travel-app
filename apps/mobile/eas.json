{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_PERF_LOG": "1" },
      "android": { "buildType": "apk" }
    },
    "e2e": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_PERF_LOG": "1", "EXPO_PUBLIC_E2E": "1" }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
