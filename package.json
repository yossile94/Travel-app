{
  "name": "travel-app",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react": "19.3.0"
  },
  "engines": {
    "node": "^24.3.0"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/**/*.test.mjs\" && npm run test --workspaces --if-present",
    "build:countries": "node scripts/build-countries.mjs",
    "build:country-meta": "node scripts/build-country-meta.mjs",
    "build:geo": "npm run build:countries && npm run build:country-meta && npm run build:search",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-search-index.mjs && prettier --write apps/mobile/src/features/search/searchIndex.json"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  },
  "devDependencies": {
    "countries-and-timezones": "3.10.0",
    "country-to-currency": "3.0.1",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3"
  }
}
